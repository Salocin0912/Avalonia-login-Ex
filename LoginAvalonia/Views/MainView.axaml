<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoginAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LoginAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- StackPanel -->
    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
        
        <!-- TextBlock di benvenuto/Greeting -->
        <TextBlock Text="{Binding Greeting}" 
                   HorizontalAlignment="Center" 
                   TextAlignment="Center" 
                   TextWrapping="Wrap"
                   FontSize="18"
                   FontWeight="Bold"/>

        <!-- ListBox per selezione nome -->
        <StackPanel Spacing="5">
            <TextBlock Text="Seleziona un nome dall'elenco:" FontSize="12" Foreground="Gray"/>
            <ListBox ItemsSource="{Binding Names}" 
                     SelectedItem="{Binding SelectedName}" 
                     Height="120"/>
        </StackPanel>
        
        <!-- TextBox modificata in campo Password + aggiunta carattere "special"  -->
        <TextBox PasswordChar="*" 
                 Watermark="Inserisci la password 🗣️️🔥" 
                 Text="{Binding Password}"/>
        
        <!-- Pulsante per effettuare l'accesso -->
        <Button HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding LoginCommand}"
                Content="{Binding StatusLogin}"/>
        
    </StackPanel>
</UserControl>